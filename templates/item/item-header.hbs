<header class="sheet-header">
    <div class="img-container">
        <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"/>
    </div>

    <div class="header-details">
        <h1 class="charname">
            <input name="name" type="text" value="{{item.name}}">
        </h1>
    </div>
</header>